#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

/ {
    behaviors {
        bspc_del: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp DELETE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        shift_caps: shift_caps {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LSHIFT>, <&kp CAPSLOCK>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
//    ┌──────┬───┬───┬───┬───┬───┐                                           ┌───┬───┬───┬───┬───┬──────┐
//    │ tab  │ Q │ W │ E │ R │ T │                                           │ Y │ U │ I │ O │ P │ bspc │
//    ├──────┼───┼───┼───┼───┼───┤                                           ├───┼───┼───┼───┼───┼──────┤
//    │ lsft │ A │ S │ D │ F │ G │                                           │ H │ J │ K │ L │ ; │ esc  │
//    ├──────┼───┼───┼───┼───┼───┤                                           ├───┼───┼───┼───┼───┼──────┤
//    │ lctl │ Z │ X │ C │ V │ B │                                           │ N │ M │ , │ . │ / │  '   │
//    └──────┴───┴───┴───┴───┴───┼──────┬──────┬─────┐   ┌─────┬──────┬──────┼───┴───┴───┴───┴───┴──────┘
//                               │ lgui │ mo 1 │ spc │   │ ent │ mo 2 │ ralt │
//                               └──────┴──────┴─────┘   └─────┴──────┴──────┘
  &kp TAB     &kp Q   &kp W   &kp E   &kp R   &kp T                                                                   &kp Y   &kp U   &kp I       &kp O     &kp P      &kp BSPC
  &kp LSHFT   &kp A   &kp S   &kp D   &kp F   &kp G                                                                   &kp H   &kp J   &kp K       &kp L     &kp SEMI   &kp ESC
  &kp LCTRL   &kp Z   &kp X   &kp C   &kp V   &kp B                                                                   &kp N   &kp M   &kp COMMA   &kp DOT   &kp FSLH   &kp SQT
                                                      &kp LGUI   &mo 1   &kp SPACE       &kp RET   &mo 2   &kp RALT
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
//    ┌────────┬────────────────┬──────────┬──────────┬──────────┬──────────┐                                         ┌──────┬──────┬─────┬──────┬─────┬──────┐
//    │  tab   │       1        │    2     │    3     │    4     │    5     │                                         │  6   │  7   │  8  │  9   │  0  │ bspc │
//    ├────────┼────────────────┼──────────┼──────────┼──────────┼──────────┤                                         ├──────┼──────┼─────┼──────┼─────┼──────┤
//    │  lsft  │    bt_sel 0    │ bt_sel 1 │ bt_sel 2 │ bt_sel 3 │ bt_sel 4 │                                         │ left │ down │ up  │ rght │     │      │
//    ├────────┼────────────────┼──────────┼──────────┼──────────┼──────────┤                                         ├──────┼──────┼─────┼──────┼─────┼──────┤
//    │ bt_clr │ &studio_unlock │          │          │          │          │                                         │      │      │     │      │     │      │
//    └────────┴────────────────┴──────────┴──────────┴──────────┴──────────┼──────┬─────┬─────┐   ┌─────┬─────┬──────┼──────┴──────┴─────┴──────┴─────┴──────┘
//                                                                          │ lgui │     │ spc │   │ ent │     │ ralt │
//                                                                          └──────┴─────┴─────┘   └─────┴─────┴──────┘
  &kp TAB      &kp N1           &kp N2         &kp N3         &kp N4         &kp N5                                                                           &kp N6     &kp N7     &kp N8   &kp N9      &kp N0   &kp BSPC
  &kp LSHFT    &bt BT_SEL 0     &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4                                                                     &kp LEFT   &kp DOWN   &kp UP   &kp RIGHT   &trans   &trans
  &bt BT_CLR   &studio_unlock   &trans         &trans         &trans         &trans                                                                           &trans     &trans     &trans   &trans      &trans   &trans
                                                                                            &kp LGUI   &trans   &kp SPACE       &kp RET   &trans   &kp RALT
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
//    ┌──────┬─────┬─────┬─────┬─────┬─────┐                                         ┌───┬───┬──────┬───┬───┬──────┐
//    │ tab  │  !  │  @  │  #  │  $  │  %  │                                         │ ^ │ & │ kp_* │ ( │ ) │ bspc │
//    ├──────┼─────┼─────┼─────┼─────┼─────┤                                         ├───┼───┼──────┼───┼───┼──────┤
//    │ lsft │     │     │     │     │     │                                         │ - │ = │  [   │ ] │ \ │  `   │
//    ├──────┼─────┼─────┼─────┼─────┼─────┤                                         ├───┼───┼──────┼───┼───┼──────┤
//    │ lctl │     │     │     │     │     │                                         │ _ │ + │  {   │ } │ | │  ~   │
//    └──────┴─────┴─────┴─────┴─────┴─────┼──────┬─────┬─────┐   ┌─────┬─────┬──────┼───┴───┴──────┴───┴───┴──────┘
//                                         │ lgui │     │ spc │   │ ent │     │ ralt │
//                                         └──────┴─────┴─────┘   └─────┴─────┴──────┘
  &kp TAB     &kp EXCL   &kp AT   &kp HASH   &kp DLLR   &kp PRCNT                                                                     &kp CARET   &kp AMPS    &kp KP_MULTIPLY   &kp LPAR   &kp RPAR   &kp BSPC
  &kp LSHFT   &trans     &trans   &trans     &trans     &trans                                                                        &kp MINUS   &kp EQUAL   &kp LBKT          &kp RBKT   &kp BSLH   &kp GRAVE
  &kp LCTRL   &trans     &trans   &trans     &trans     &trans                                                                        &kp UNDER   &kp PLUS    &kp LBRC          &kp RBRC   &kp PIPE   &kp TILDE
                                                                    &kp LGUI   &trans   &kp SPACE       &kp RET   &trans   &kp RALT
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
//    ┌─────────┬─────┬────┬────┬────┬─────┐                                             ┌──────┬──────┬──────┬──────┬──────┬──────┐
//    │ mo tab  │     │ f7 │ f8 │ f9 │ f12 │                                             │      │ mute │ volu │ vold │      │ bspc │
//    ├─────────┼─────┼────┼────┼────┼─────┤                                             ├──────┼──────┼──────┼──────┼──────┼──────┤
//    │  lctl   │     │ f4 │ f5 │ f6 │ f11 │                                             │ prev │  rw  │ play │  ff  │ next │  cc  │
//    ├─────────┼─────┼────┼────┼────┼─────┤                                             ├──────┼──────┼──────┼──────┼──────┼──────┤
//    │ bt_lsft │     │ f1 │ f2 │ f3 │ f10 │                                             │      │      │      │      │      │      │
//    └─────────┴─────┴────┴────┴────┴─────┼──────┬────────┬─────┐   ┌─────┬──────┬──────┼──────┴──────┴──────┴──────┴──────┴──────┘
//                                         │ lgui │ mo NAV │ spc │   │ ent │ mo 2 │ ralt │
//                                         └──────┴────────┴─────┘   └─────┴──────┴──────┘
  &mo TAB     &trans   &kp F7   &kp F8   &kp F9   &kp F12                                                                     &trans       &kp C_MUTE   &kp C_VOL_UP   &kp C_VOL_DN   &trans       &kp BSPC
  &kp LCTRL   &trans   &kp F4   &kp F5   &kp F6   &kp F11                                                                     &kp K_PREV   &kp C_RW     &kp K_PP       &kp C_FF       &kp K_NEXT   &kp C_CAPTIONS
  &bt LSHFT   &trans   &kp F1   &kp F2   &kp F3   &kp F10                                                                     &trans       &trans       &trans         &trans         &trans       &trans
                                                            &kp LGUI   &mo NAV   &kp SPACE       &kp RET   &mo 2   &kp RALT
            >;
        };

        mouse {
            display-name = "MOU";
            bindings = <
//    ┌─────┬─────┬─────┬─────┬─────┬─────┐                                             ┌─────┬─────┬─────┬─────┬─────┬─────┐
//    │     │     │     │     │     │     │                                             │     │     │     │     │     │     │
//    ├─────┼─────┼─────┼─────┼─────┼─────┤                                             ├─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │     │     │     │     │     │                                             │     │     │     │     │     │     │
//    ├─────┼─────┼─────┼─────┼─────┼─────┤                                             ├─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │     │     │     │     │     │                                             │     │     │     │     │     │     │
//    └─────┴─────┴─────┴─────┴─────┴─────┼──────┬──────┬──────┐   ┌──────┬──────┬──────┼─────┴─────┴─────┴─────┴─────┴─────┘
//                                        │ mclk │ lclk │ rclk │   │ lclk │ rclk │ mclk │
//                                        └──────┴──────┴──────┘   └──────┴──────┴──────┘
  &trans   &trans   &trans   &trans   &trans   &trans                                                                               &trans   &trans   &trans   &trans   &trans   &trans
  &trans   &trans   &trans   &trans   &trans   &trans                                                                               &trans   &trans   &trans   &trans   &trans   &trans
  &trans   &trans   &trans   &trans   &trans   &trans                                                                               &trans   &trans   &trans   &trans   &trans   &trans
                                                        &mkp MCLK   &mkp LCLK   &mkp RCLK       &mkp LCLK   &mkp RCLK   &mkp MCLK
            >;
        };

        extra_2 {
                status = "reserved";
        };

        extra_3 {
                status = "reserved";
        };
    };
};
