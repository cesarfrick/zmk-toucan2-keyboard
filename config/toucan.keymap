#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

/ {
    behaviors {
        bspc_del: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            display-name = "BSPC_DEL";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp DELETE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        shift_caps: shift_caps {
            compatible = "zmk,behavior-tap-dance";
            display-name = "SHIFT_CAPS";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LSHIFT>, <&kp CAPSLOCK>;
        };

        mt: mod_tap {
          tapping-term-ms = <150>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
//    ┌─────────────┬───┬───┬───┬───┬───┐                                           ┌───┬───┬───┬───┬───┬───────────┐
//    │     tab     │ Q │ W │ E │ R │ T │                                           │ Y │ U │ I │ O │ P │ &bspc_del │
//    ├─────────────┼───┼───┼───┼───┼───┤                                           ├───┼───┼───┼───┼───┼───────────┤
//    │ &shift_caps │ A │ S │ D │ F │ G │                                           │ H │ J │ K │ L │ ; │ mt rsft ' │
//    ├─────────────┼───┼───┼───┼───┼───┤                                           ├───┼───┼───┼───┼───┼───────────┤
//    │    lctl     │ Z │ X │ C │ V │ B │                                           │ N │ M │ , │ . │ / │    esc    │
//    └─────────────┴───┴───┴───┴───┴───┼──────┬──────┬─────┐   ┌─────┬──────┬──────┼───┴───┴───┴───┴───┴───────────┘
//                                      │ lgui │ mo 1 │ spc │   │ ent │ mo 2 │ ralt │
//                                      └──────┴──────┴─────┘   └─────┴──────┴──────┘
  &kp TAB       &kp Q   &kp W   &kp E   &kp R   &kp T                                                                   &kp Y   &kp U   &kp I       &kp O     &kp P      &bspc_del
  &shift_caps   &kp A   &kp S   &kp D   &kp F   &kp G                                                                   &kp H   &kp J   &kp K       &kp L     &kp SEMI   &mt RSHIFT SQT
  &kp LCTRL     &kp Z   &kp X   &kp C   &kp V   &kp B                                                                   &kp N   &kp M   &kp COMMA   &kp DOT   &kp FSLH   &kp ESC
                                                        &kp LGUI   &mo 1   &kp SPACE       &kp RET   &mo 2   &kp RALT
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
//    ┌─────────────┬────────────────┬──────────┬──────────┬──────────┬──────────┐                                         ┌──────┬──────┬─────┬──────┬──────┬───────────┐
//    │     tab     │       1        │    2     │    3     │    4     │    5     │                                         │  6   │  7   │  8  │  9   │  0   │ &bspc_del │
//    ├─────────────┼────────────────┼──────────┼──────────┼──────────┼──────────┤                                         ├──────┼──────┼─────┼──────┼──────┼───────────┤
//    │ &shift_caps │    bt_sel 0    │ bt_sel 1 │ bt_sel 2 │ bt_sel 3 │ bt_sel 4 │                                         │ left │ down │ up  │ rght │ rctl │           │
//    ├─────────────┼────────────────┼──────────┼──────────┼──────────┼──────────┤                                         ├──────┼──────┼─────┼──────┼──────┼───────────┤
//    │   bt_clr    │ &studio_unlock │          │          │          │          │                                         │      │      │     │      │      │           │
//    └─────────────┴────────────────┴──────────┴──────────┴──────────┴──────────┼──────┬─────┬─────┐   ┌─────┬─────┬──────┼──────┴──────┴─────┴──────┴──────┴───────────┘
//                                                                               │ lgui │     │ spc │   │ ent │     │ ralt │
//                                                                               └──────┴─────┴─────┘   └─────┴─────┴──────┘
  &kp TAB       &kp N1           &kp N2         &kp N3         &kp N4         &kp N5                                                                           &kp N6     &kp N7     &kp N8   &kp N9      &kp N0      &bspc_del
  &shift_caps   &bt BT_SEL 0     &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4                                                                     &kp LEFT   &kp DOWN   &kp UP   &kp RIGHT   &kp RCTRL   &trans
  &bt BT_CLR    &studio_unlock   &trans         &trans         &trans         &trans                                                                           &trans     &trans     &trans   &trans      &trans      &trans
                                                                                             &kp LGUI   &trans   &kp SPACE       &kp RET   &trans   &kp RALT
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
//    ┌─────────────┬─────┬─────┬─────┬─────┬─────┐                                         ┌───┬───┬──────┬───┬───┬───────────┐
//    │     tab     │  !  │  @  │  #  │  $  │  %  │                                         │ ^ │ & │ kp_* │ ( │ ) │ &bspc_del │
//    ├─────────────┼─────┼─────┼─────┼─────┼─────┤                                         ├───┼───┼──────┼───┼───┼───────────┤
//    │ &shift_caps │     │     │     │     │     │                                         │ - │ = │  [   │ ] │ \ │     `     │
//    ├─────────────┼─────┼─────┼─────┼─────┼─────┤                                         ├───┼───┼──────┼───┼───┼───────────┤
//    │    lalt     │     │     │     │     │     │                                         │ _ │ + │  {   │ } │ | │     ~     │
//    └─────────────┴─────┴─────┴─────┴─────┴─────┼──────┬─────┬─────┐   ┌─────┬─────┬──────┼───┴───┴──────┴───┴───┴───────────┘
//                                                │ lgui │     │ spc │   │ ent │     │ ralt │
//                                                └──────┴─────┴─────┘   └─────┴─────┴──────┘
  &kp TAB       &kp EXCL   &kp AT   &kp HASH   &kp DLLR   &kp PRCNT                                                                     &kp CARET   &kp AMPS    &kp KP_MULTIPLY   &kp LPAR   &kp RPAR   &bspc_del
  &shift_caps   &trans     &trans   &trans     &trans     &trans                                                                        &kp MINUS   &kp EQUAL   &kp LBKT          &kp RBKT   &kp BSLH   &kp GRAVE
  &kp LALT      &trans     &trans   &trans     &trans     &trans                                                                        &kp UNDER   &kp PLUS    &kp LBRC          &kp RBRC   &kp PIPE   &kp TILDE
                                                                      &kp LGUI   &trans   &kp SPACE       &kp RET   &trans   &kp RALT
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
//    ┌─────┬─────┬────┬────┬────┬─────┐                                             ┌──────┬──────┬──────┬──────┬──────┬─────┐
//    │     │     │ f7 │ f8 │ f9 │ f12 │                                             │      │ mute │ volu │ vold │      │     │
//    ├─────┼─────┼────┼────┼────┼─────┤                                             ├──────┼──────┼──────┼──────┼──────┼─────┤
//    │     │     │ f4 │ f5 │ f6 │ f11 │                                             │ prev │  rw  │ play │  ff  │ next │ cc  │
//    ├─────┼─────┼────┼────┼────┼─────┤                                             ├──────┼──────┼──────┼──────┼──────┼─────┤
//    │     │     │ f1 │ f2 │ f3 │ f10 │                                             │      │      │      │      │      │     │
//    └─────┴─────┴────┴────┴────┴─────┼──────┬────────┬─────┐   ┌─────┬──────┬──────┼──────┴──────┴──────┴──────┴──────┴─────┘
//                                     │ lgui │ mo NAV │ spc │   │ ent │ mo 2 │ ralt │
//                                     └──────┴────────┴─────┘   └─────┴──────┴──────┘
  &trans   &trans   &kp F7   &kp F8   &kp F9   &kp F12                                                                     &trans       &kp K_MUTE   &kp K_VOL_UP       &kp K_VOL_DN   &trans       &trans
  &trans   &trans   &kp F4   &kp F5   &kp F6   &kp F11                                                                     &kp K_PREV   &kp C_RW     &kp C_PLAY_PAUSE   &kp C_FF       &kp K_NEXT   &kp C_CAPTIONS
  &trans   &trans   &kp F1   &kp F2   &kp F3   &kp F10                                                                     &trans       &trans       &trans             &trans         &trans       &trans
                                                         &kp LGUI   &mo NAV   &kp SPACE       &kp RET   &mo 2   &kp RALT
            >;
        };

        mouse {
            display-name = "MOU";
            bindings = <
//    ┌─────┬─────┬─────┬─────┬─────┬─────┐                                             ┌─────┬─────┬─────┬─────┬─────┬─────┐
//    │     │     │     │     │     │     │                                             │     │     │     │     │     │     │
//    ├─────┼─────┼─────┼─────┼─────┼─────┤                                             ├─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │     │     │     │     │     │                                             │     │     │     │     │     │     │
//    ├─────┼─────┼─────┼─────┼─────┼─────┤                                             ├─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │     │     │     │     │     │                                             │     │     │     │     │     │     │
//    └─────┴─────┴─────┴─────┴─────┴─────┼──────┬──────┬──────┐   ┌──────┬──────┬──────┼─────┴─────┴─────┴─────┴─────┴─────┘
//                                        │ mclk │ lclk │ rclk │   │ lclk │ rclk │ mclk │
//                                        └──────┴──────┴──────┘   └──────┴──────┴──────┘
  &trans   &trans   &trans   &trans   &trans   &trans                                                                               &trans   &trans   &trans   &trans   &trans   &trans
  &trans   &trans   &trans   &trans   &trans   &trans                                                                               &trans   &trans   &trans   &trans   &trans   &trans
  &trans   &trans   &trans   &trans   &trans   &trans                                                                               &trans   &trans   &trans   &trans   &trans   &trans
                                                        &mkp MCLK   &mkp LCLK   &mkp RCLK       &mkp LCLK   &mkp RCLK   &mkp MCLK
            >;
        };

        extra_2 {
                status = "reserved";
        };

        extra_3 {
                status = "reserved";
        };
    };
};
